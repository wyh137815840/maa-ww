{
    "StartupMain": {
        "desc": "启动：冷/软拉起 → 标题点连接 → 之后每 10s 查手柄模式，不符则按 A 切一次，最多 15 次；认到 PadReady 才成功。",
        "next": [
            "CloseGame",
            "StartUpGame"
        ]
    },
    "CloseGame": {
        "desc": "am force-stop com.kurogame.mingchao",
        "recognition": "DirectHit",
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.kurogame.mingchao"
            }
        },
        "next": [
            "StartUpGame"
        ]
    },
    "StartUpGame": {
        "desc": "am start -n com.kurogame.mingchao/com.epicgames.ue4.GameActivity。仅拉起，不视为任务完成。",
        "recognition": "DirectHit",
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.kurogame.mingchao/com.epicgames.ue4.GameActivity"
            }
        },
        "next": [
            "StartUpGameWait"
        ]
    },
    "StartUpGameWait": {
        "desc": "加载期循环：有底部进度条则继续等；月卡 / 出本 / 点连接 / 登录 / 大世界。禁止挂 DirectHit（PadWatch）。",
        "timeout": 240000,
        "next": [
            "StartupLoadingBar",
            "StartupLoadingBarOCR",
            "StartupWorldLoadingBar",
            "StartupMonthlyCard",
            "InInstanceExitIcon",
            "ConfirmLeaveInstance",
            "ConfirmLeaveInstanceByOCR",
            "TitleClickConnect",
            "TitleClickConnectOCR",
            "StartupLoginConfirm",
            "StartupWorldHUD",
            "StartupWorldReady"
        ]
    },
    "StartupLoadingBar": {
        "desc": "游戏更新进度条。读条中自循环；读完必须进 PadWatch（禁止回 StartUpGameWait，否则丢切手柄）。",
        "recognition": "TemplateMatch",
        "roi": [40, 610, 1200, 100],
        "template": "Title/StartupLoadingBar.png",
        "threshold": 0.70,
        "action": "DoNothing",
        "post_delay": 1500,
        "next": [
            "StartupLoadingBar",
            "StartupLoadingBarOCR",
            "StartupWorldLoadingBar",
            "StartupPadWatch"
        ]
    },
    "StartupLoadingBarOCR": {
        "desc": "更新/着色器文案 OCR 兜底。读完必须进 PadWatch。",
        "recognition": "OCR",
        "roi": [40, 600, 800, 110],
        "expected": ["更新", "下载", "正在下载", "正在编译着色器", "编译着色器"],
        "action": "DoNothing",
        "post_delay": 1500,
        "next": [
            "StartupLoadingBar",
            "StartupLoadingBarOCR",
            "StartupWorldLoadingBar",
            "StartupPadWatch"
        ]
    },
    "StartupWorldLoadingBar": {
        "desc": "大世界读取进度条。自循环等到消失后进 PadWatch；禁止回 StartUpGameWait（日志 12:00:56 曾因此丢切手柄）。",
        "recognition": "TemplateMatch",
        "roi": [0, 650, 1280, 70],
        "template": "Title/StartupWorldLoadingBar.png",
        "threshold": 0.72,
        "action": "DoNothing",
        "post_delay": 1200,
        "next": [
            "StartupWorldLoadingBar",
            "StartupLoadingBar",
            "StartupLoadingBarOCR",
            "StartupPadWatch"
        ]
    },
    "StartupMonthlyCard": {
        "desc": "月相观测卡。认到「点击领取今日月相观测卡奖励」就点一下屏幕。不判断是否首次、不看时间。",
