    "StartupPadWatch": {
        "desc": "手柄轮询封闭环：只认 PadReady 或按 A。禁止再挂读条节点（读条会把流程拐进 Wait 并永久丢切换）。",
        "recognition": "DirectHit",
        "action": "DoNothing",
        "timeout": 160000,
        "next": [
            "StartupPadReady",
            "StartupPadSwitchOnce"
        ]
    },
    "StartupPadSwitchOnce": {
        "desc": "非手柄：按物理 Xbox A。最多 15 次。",
        "recognition": "DirectHit",
        "action": {"type": "ClickKey", "param": {"key": 96}},
        "repeat": 2,
        "post_delay": 600,
        "max_hit": 15,
        "timeout": 8000,
        "next": [
            "StartupPadConfirm",
            "StartupPadReady",
            "StartupPadCheckWait"
        ]
    },
