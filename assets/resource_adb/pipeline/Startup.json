{
    "StartupMain": {
        "desc": "启动：冷/软拉起 → 标题点连接 → 之后每 10s 查手柄模式，不符则按 A 切一次，最多 15 次；认到 PadReady 才成功。",
        "next": [
            "CloseGame",
            "StartUpGame"
        ]
    },
    "CloseGame": {
        "desc": "am force-stop com.kurogame.mingchao",
        "recognition": "DirectHit",
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.kurogame.mingchao"
            }
        },
        "next": [
            "StartUpGame"
        ]
    },
    "StartUpGame": {
        "desc": "am start -n com.kurogame.mingchao/com.epicgames.ue4.GameActivity。仅拉起，不视为任务完成。",
        "recognition": "DirectHit",
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.kurogame.mingchao/com.epicgames.ue4.GameActivity"
            }
        },
        "next": [
            "StartUpGameWait"
        ]
    },
