{
    "task": [
        {
            "name": "Nest",
            "label": "$task.Nest.label",
            "description": "$task.Nest.description",
            "entry": "NestRun",
            "controller": [
                "ADB"
            ],
            "option": [
                "NestKind"
            ]
        }
    ],
    "option": {
        "NestKind": {
            "type": "checkbox",
            "label": "$option.NestKind.label",
            "description": "$option.NestKind.description",
            "default_case": [
                "Canxiang"
            ],
            "cases": [
                {
                    "name": "Canxiang",
                    "label": "$option.NestKind.case.Canxiang",
                    "pipeline_override": {
                        "NestKindCanxiang": {
                            "attach": {
                                "on": true
                            }
                        }
                    }
                },
                {
                    "name": "Nightmare",
                    "label": "$option.NestKind.case.Nightmare",
                    "pipeline_override": {
                        "NestKindNightmare": {
                            "attach": {
                                "on": true
                            }
                        }
                    }
                }
            ],
            "min_count": 1
        }
    }
}
