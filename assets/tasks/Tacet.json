                        "TacetGoIndex2": {
                            "enabled": true
                        },
                        "TacetGoIndex3": {
                            "enabled": false
                        },
                        "TacetGoIndex4": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "3",
                    "label": "$option.TacetIndex.case3",
                    "pipeline_override": {
                        "TacetGoIndex1": {
