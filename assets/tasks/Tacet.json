                        "TacetGoIndex2": {
                            "enabled": false
                        },
                        "TacetGoIndex3": {
                            "enabled": true
                        },
                        "TacetGoIndex4": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "4",
                    "label": "$option.TacetIndex.case4",
                    "pipeline_override": {
                        "TacetGoIndex1": {
                            "enabled": false
                        },
                        "TacetGoIndex2": {
                            "enabled": false
                        },
                        "TacetGoIndex3": {
                            "enabled": false
