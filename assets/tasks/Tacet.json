                        },
                        "TacetGoIndex2": {
                            "enabled": false
                        },
                        "TacetGoIndex3": {
                            "enabled": false
                        },
                        "TacetGoIndex4": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "2",
                    "label": "$option.TacetIndex.case2",
                    "pipeline_override": {
                        "TacetGoIndex1": {
                            "enabled": false
